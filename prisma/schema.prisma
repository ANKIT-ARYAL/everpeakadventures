datasource db {
  provider = "postgresql"  
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------
// HOMEPAGE & GENERAL MODELS
// ----------------------------------------

model HeroContent {
  id                String   @id @default(uuid())
  topLabel          String?
  mainHeading       String?
  subtext           String?
  youtubeVideoId    String?
  searchPlaceholder String?
  primaryButtonText   String? @default("▲ View Treks")
  primaryButtonLink   String? @default("/trekking")
  secondaryButtonText String? @default("Book Now")
  secondaryButtonLink String? @default("/send-inquiry")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Trek {
  id             String   @id @default(cuid())
  slug           String?   @unique
  title          String
  description    String   @db.Text // Short description for cards
  overview       String?  @db.Text // Full overview content
  heroImage      String
  gallery        String[] // Array of image URLs

  // Quick Facts (Trip Meta)
  durationDays   String
  price          Float
  region         String
  difficulty     String   // e.g., Moderate, Strenuous
  maxAltitude    String?
  bestSeason     String?
  accommodation  String?
  meals          String?
  groupSize      String?
  transport      String?

  // Detailed Data (Arrays & JSON)
  highlights     String[]
  inclusions     String[]
  exclusions     String[]
  packingList    String[]
  itinerary      Json?    // Stores array of { day: number, title: string, desc: string }
  
  // Meta & Sorting
  mapUrl         String?  // For elevation map images
  isBestSeller   Boolean  @default(false)
  order          Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Tour {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  image           String   // Hero / Featured Image
  gallery         String[] // Additional gallery images
  duration        String
  bestTime        String
  destination     String   @default("nepal")
  
  grade           String   @default("Easy / Moderate")
  maxAltitude     String   @default("1,350 m")
  startPoint      String   @default("Kathmandu")
  endPoint        String   @default("Kathmandu")
  meals           String   @default("B.B.")
  overview        String   @default("")
  
  highlights      String[]
  itinerary       Json?
  inclusions      String[]
  exclusions      String[]
  
  price           Float    @default(0)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
model BlogPost {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  content      String?   @db.Text // Full HTML/Rich text body from the main editor
  excerpt      String   @db.Text // Short description for cards
  image        String   // Featured image URL
  category     String   @default("Trekking / Hiking")
  tags         String[] // Array of tags
  date         String   // E.g., 'September 15, 2026'
  
  // Yoast SEO Meta Fields
  seoTitle     String?
  metaDescription String? @db.Text
  focusKeyphrase String?

  // Related FAQs (Repeater from WordPress bottom section)
  faqs         Json?    // Stores array of { question: string, answer: string }

  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ClientReview {
  id        String   @id @default(uuid())
  quote     String
  name      String
  location  String   @default("")
  avatar    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestimonialSectionContent {
  id        String   @id @default(uuid())
  title     String   @default("WHAT OUR CLIENT SAY ABOUT US ?")
  subtitle  String   @default("Real experiences shared by travelers who trusted us.")
  watermark String   @default("CLIENTS REVIEWS")
  updatedAt DateTime @updatedAt
}

model BlueBannerContent {
  id          String   @id @default(uuid())
  title       String   @default("Explore the Himalayas with Trusted Local Experts")
  subtitle    String   @default("Ever Peak Adventures offers unforgettable trekking, peak climbing, and cultural journeys across Everest, Annapurna, and beyond. Safe, authentic, and professionally guided.")
  buttonText  String   @default("View All Trek Packages →")
  buttonLink  String   @default("/tours")
  updatedAt   DateTime @updatedAt
}
// ----------------------------------------
// STATIC & SUB-PAGE MODELS
// ----------------------------------------

model AboutPageContent {
  id               String   @id @default(uuid())
  title            String   @default("About Us")
  featuredImage    String   @default("https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?q=80&w=1000&auto=format&fit=crop")
  
  // Statistics Grid
  happyTravelers   String   @default("1,000+")
  yearsExperience  String   @default("10+")
  successfulTrips  String   @default("100+")
  expertGuides     String   @default("20+")

  // Main Story Content (Paragraphs)
  paragraph1       String   @default("Ever Peak Adventure is a leading Nepal-based adventure travel company dedicated to delivering authentic, safe, and unforgettable Himalayan experiences. Established by a team of passionate mountaineers and experienced travel professionals, our company was founded with a clear vision—to share the true spirit of the Himalayas through responsible, well-organized, and meaningful adventures.")
  paragraph2       String   @default("We specialize in trekking, hiking, peak climbing, mountaineering, and cultural tours across Nepal's most breathtaking and diverse landscapes. Fully licensed by the Ministry of Tourism, Government of Nepal, and proud members of the Trekking Agencies Association of Nepal (TAAN) and the Nepal Mountaineering Association (NMA), Ever Peak Adventure operates with the highest standards of professionalism, safety, and ethical responsibility.")
  paragraph3       String   @default("We strictly follow government regulations and international safety guidelines to ensure every journey is conducted with care, transparency, and respect for both travelers and local communities. With more than a decade of hands-on experience, our expert guides, climbing leaders, and support team have successfully guided travelers from around the world through iconic regions such as Everest, Annapurna, Langtang, Manaslu, and beyond.")
  paragraph4       String   @default("Our guides are highly trained, knowledgeable, and deeply familiar with the terrain, culture, and challenges of high-altitude travel, ensuring both safety and enriching experiences throughout. At Ever Peak Adventure, we believe that travel is more than just reaching a destination—it is about meaningful connections, cultural discovery, and personal achievement. From world-famous trekking routes to hidden valleys and culturally rich destinations, every journey we design is carefully customized to match your interests, schedule, fitness level, and sense of adventure.")

  // Culture Banner
  cultureTitle     String   @default("Our Company Culture")
  cultureText      String   @default("Driven by passion, integrity, and respect, we foster a safety-first, team-oriented culture that values authentic experiences, responsible tourism, and genuine care for every traveler and community we serve.")

  // Mission, Vision & Goals
  missionText      String   @default("To deliver safe, authentic, and enriching Himalayan adventure experiences while promoting responsible tourism, cultural respect, and environmental sustainability, ensuring every journey creates meaningful memories and positive impact for travelers and local communities alike.")
  visionText       String   @default("To become a globally trusted adventure travel company recognized for excellence, integrity, and innovation showcasing Nepal as a premier destination for trekking, mountaineering, and cultural exploration while preserving its natural beauty and heritage for future generations.")
  goalsText        String   @default("To design and operate high-quality, personalized adventure journeys that inspire confidence, challenge limits, and foster genuine connections while upholding the highest standards of safety, professionalism, and ethical responsibility in the Himalayas.")

  updatedAt        DateTime @updatedAt
}

