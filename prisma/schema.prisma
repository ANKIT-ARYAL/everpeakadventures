datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------
// TOUR PACKAGES MODELS
// ----------------------------------------

// Group Pricing Repeater Box (e.g., Pax 1-2, 3-5, etc.)
model TourGroupPrice {
  id        String @id @default(uuid())
  groupSize String // e.g., "2 - 4"
  groupType String @default("Best Value") // e.g., "Small Group", "Best Value", "Super Group"
  price     String // e.g., "US$ 2,599"
  tourId    String
  tour      Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

// Fixed Departure Schedule Box (Group Size, Dates, Status)
model TourSchedule {
  id        String @id @default(uuid())
  groupSize String // e.g., "2-12 Pax"
  dateRange String // e.g., "15 Sep - 28 Sep"
  status    String // e.g., "Book"
  tourId    String
  tour      Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

// ----------------------------------------
// HOMEPAGE & GENERAL MODELS
// ----------------------------------------

model HeroContent {
  published Boolean @default(true) // show/hide this section on the frontend
  id                  String   @id @default(uuid())
  topLabel            String?
  mainHeading         String?
  subtext             String?
  heroMediaType       String?  @default("youtube") // "youtube" | "video" | "image"
  heroMediaUrl        String?  // uploaded file URL, used when mediaType is video/image
  youtubeVideoId      String?
  searchPlaceholder   String?
  primaryButtonText   String?  @default("▲ View Treks")
  primaryButtonLink   String?  @default("/trekking")
  secondaryButtonText String?  @default("Book Now")
  secondaryButtonLink String?  @default("/send-inquiry")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Trek {
  published Boolean @default(true) // show/hide this section on the frontend
  id              String   @id @default(cuid())
  slug            String?  @unique
  title           String
  description     String   @db.Text
  overview        String?  @db.Text
  heroImage       String
  gallery         String[]
  discountedPrice Float? // Current price, e.g. US$ 2,499
  originalPrice   Float? // Regular price (strikethrough), e.g. US$ 2,975
  priceRange      String? // e.g. "US$ 2,499 - US$ 2,975"
  isAllInclusive  Boolean  @default(false)

  // Quick Facts
  durationDays  String
  price         Float
  region        String
  difficulty    String
  maxAltitude   String?
  bestSeason    String?
  accommodation String?
  meals         String?
  groupSize     String?
  transport     String?
  activity      String? // e.g. Trekking/Peak Climbing

  // Region Taxonomy (checkboxes) - includes 'All Trekking Packages'
  regions String[]

  // Relational sections mirroring the WordPress admin metaboxes
  groupPrices    TrekGroupPrice[]
  fixedSchedules TrekSchedule[]

  highlights  String? @db.Text
  inclusions  String? @db.Text
  exclusions  String? @db.Text
  packingList String? @db.Text
  itinerary   Json?

  videoUrl  String? // Trek video (uploaded file path or YouTube URL)
  videoType String? // "upload" | "youtube"

  mapUrl   String?
  mapImage String?
  routeMap Json?

  isBestSeller Boolean @default(false)
  order        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Group Pricing Repeater Box (e.g., Pax 1-2, 3-5, etc.)
model TrekGroupPrice {
  id        String @id @default(uuid())
  groupSize String // e.g., "2 - 4"
  groupType String @default("Best Value") // e.g., "Small Group", "Best Value", "Super Group"
  price     String // e.g., "US$ 2,599"
  trekId    String
  trek      Trek   @relation(fields: [trekId], references: [id], onDelete: Cascade)
}

// Fixed Departure Schedule Box (Group Size, Dates, Status)
model TrekSchedule {
  id        String @id @default(uuid())
  groupSize String // e.g., "2-12 Pax"
  dateRange String // e.g., "15 Sep - 28 Sep"
  status    String // e.g., "Book"
  trekId    String
  trek      Trek   @relation(fields: [trekId], references: [id], onDelete: Cascade)
}

model Tour {
  published Boolean @default(true) // show/hide this section on the frontend
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?  @db.Text // Short card description (excerpt)
  overview    String?  @db.Text // Full trip overview/description
  heroImage   String
  gallery     String[]

  // Pricing
  price           Float   @default(0) // Current price (discounted)
  discountedPrice Float? // Alias for current price
  originalPrice   Float? // Regular/cross-out price
  priceRange      String? // e.g., "US$ 1,199 - US$ 1,399"
  isAllInclusive  Boolean @default(false)

  // Quick Facts
  duration           String
  bestTime           String
  destination        String  @default("nepal") // e.g., nepal, bhutan, tibet
  primaryDestination String? // Primary destination (Nepal/Bhutan/Tibet)

  grade       String  @default("Easy / Moderate")
  maxAltitude String  @default("1,350 m")
  startPoint  String  @default("Kathmandu")
  endPoint    String  @default("Kathmandu")
  meals       String  @default("B.B.")
  activity    String? // e.g., "Sightseeing / Tour", "Trekking"
  groupSize   String? // e.g., "1 - 10"
  transport   String?
  mapUrl      String? // Route map / elevation chart URL
  mapImage    String? // Uploaded route-map graphic
  routeMap    Json?

  // Regions taxonomy (checkboxes)
  regions String[]

  // Video
  videoUrl  String?
  videoType String? // "upload" | "youtube"

  // SEO
  focusKeyphrase  String?
  seoTitle        String?
  metaDescription String? @db.Text

  // Relational sections
  groupPrices    TourGroupPrice[]
  fixedSchedules TourSchedule[]

  highlights  String? @db.Text
  inclusions  String? @db.Text
  exclusions  String? @db.Text
  packingList String? @db.Text
  itinerary   Json?

  isBestSeller Boolean @default(false)
  order        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

