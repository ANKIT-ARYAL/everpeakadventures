  bestSellersSubtitle      String   @default("\"Top-rated trekking journeys offering breathtaking views and authentic experiences.\"")
  fixedDeparturesLabel     String   @default("Departure Dates")
  fixedDeparturesTitle     String   @default("Join Fixed Departure Trips")
  popularToursWatermark    String   @default("TOURS")
  popularToursTitle        String   @default("Popular Tours")
  popularToursSubtitle     String   @default("\"Premium tour packages tailored for comfort, culture, and adventure.\"")
  exploreBlogsWatermark    String   @default("EXPLORE OUR BLOGS")
  exploreBlogsTitle        String   @default("Explore Our Blogs")
  exploreBlogsSubtitle     String   @default("At Ever Peak Adventure, we believe that travel is not just about reaching a destination—it’s about creating stories.")
