model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model ContactInfo {
  id        String   @id @default(uuid())
  address   String   @default("Kathmandu, Nepal")
  phone     String   @default("9851093960")
  email     String   @default("info@everpeakadventures.com")
  mapUrl    String   @default("https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3532.246473636257!2d85.3150!3d27.7172!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zThe Kathmandu!5e0!3m2!1sen!2snp!4v1650000000000!5m2!1sen!2snp")
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id            String   @id @default(uuid())
  firstName     String
  lastName      String
  email         String
  phone         String
  contactMethod String
  bestTime      String
  message       String
  createdAt     DateTime @default(now())
}

model Page {
  id          String    @id @default(uuid())
  slug        String    @unique // e.g., 'about-us', 'our-team', 'responsible-travel'
  title       String
  subtitle    String?
  heroImage   String?
  content     String?   // Rich text or HTML content
  sections    Section[] // Dynamic page sections
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Section {
  id          String   @id @default(uuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title       String?
  description String?
  image       String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TrustItem {
  id          String   @id @default(uuid())
  title       String
  subtitle    String
  iconName    String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FixedDeparture {
  id            String   @id @default(uuid())
  title         String
  heroImage     String
  durationDays  String   // e.g. '14 Days'
  startDate     String   // e.g. '15 Sep 2026'
  endDate       String?  // e.g. '28 Sep 2026'
  status        String   @default("Guaranteed") // 'Guaranteed', 'Filling Fast'
  seatsLeft     Int      @default(6)
  price         Float
  originalPrice Float?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}


model WelcomeContent {
  id           String   @id @default(uuid())
  companyName  String   @default("Ever Peak Adventure")
  description  String
  carouselImages String[] // Array of image URLs
  buttonText   String   @default("Know More About Us")
  buttonLink   String   @default("/about-us")
  updatedAt    DateTime @updatedAt
}

model WelcomeFeature {
  id          String   @id @default(uuid())
  title       String
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Homepage section headers / watermarks (single editable record)
