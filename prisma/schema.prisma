model TermsPageContent {
  id           String   @id @default(uuid())
  title        String   @default("Terms and Conditions")
  subtitle     String   @default("Have questions or ready to plan your Himalayan adventure? Our friendly and experienced team is here to help you every step of the way.")
  contentHtml  String   // Stores the rich HTML text body
