  founderTitle  String   @default("Founder, Ever Peak Adventures")
  founderEmail  String   @default("dipesh@everpeakadventure.com")
  founderImage  String   @default("https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=400&fit=crop")
